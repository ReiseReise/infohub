# ============================================================
# 信息中枢 v3 — 环境变量模板
# 复制为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ============================================================
# A. 基础设施
# ============================================================

# ---- 数据库 / 缓存 ----
PG_PASSWORD=change_me_secure_password
DATABASE_URL=postgres://postgres:${PG_PASSWORD}@postgres:5432/infohub
REDIS_URL=redis://redis:6379
HOST_DATA_ROOT=./data
HOST_EXPORT_ROOT=./exports
HOST_BACKUP_ROOT=./backups

# ---- 安全 / 鉴权 ----
JWT_SECRET=replace_with_a_random_32_plus_char_secret
INTERNAL_API_KEY=replace_with_a_random_32_plus_char_internal_key
JWT_EXPIRES_IN=7d
ALLOW_REGISTRATION=true
AUDIO_WEBHOOK_SECRET=replace_with_a_random_32_plus_char_webhook_secret
AUDIO_ADMIN_EMAIL=admin@example.com
AUDIO_ADMIN_PASSWORD=replace_with_a_strong_admin_password
FIRST_INVITE_CODE=replace_with_a_random_invite_code

# ---- 内部服务地址（Docker 网络） ----
RSSHUB_BASE_URL=http://rsshub:1200
CHANGEDETECTION_URL=http://changedetection:5000
CHANGEDETECTION_API_KEY=
KTN_URL=http://kill-the-newsletter:8082
AUDIO_SERVICE_URL=http://audio-service:8000
HUB_ENGINE_INTERNAL_URL=http://hub-engine:3001
SCRAPLING_SERVICE_URL=http://scrapling-service:8010

# ---- 推送 ----
NTFY_URL=http://ntfy:80
NTFY_TOPIC=infohub
FEISHU_WEBHOOK_URL=

# ---- 采集器可选配置 ----
# BILIBILI_COOKIE=
# TWITTER_AUTH_TOKEN=

# ============================================================
# B. 功能开关 / 运行时
# ============================================================

# ---- 音频任务运行时 ----
AUDIO_SERVICE_TIMEOUT_MS=20000
AUDIO_STORAGE_BACKEND=local
AUDIO_APP_ENV=production
AUDIO_APP_DEBUG=false
CELERY_TASK_SOFT_LIMIT_SECONDS=7200
CELERY_TASK_LIMIT_SECONDS=7500
CORS_ORIGINS=http://localhost:5173,http://localhost
BACKUP_LOCAL_DIR=/app/backups
BACKUP_STATUS_FILE=/app/backups/backup-status.json
BACKUP_LOCAL_RETENTION=7
BACKUP_OSS_ENABLED=false
BACKUP_OSS_BUCKET=
BACKUP_OSS_PREFIX=infohub-v3/
BACKUP_OSS_REGION=cn-beijing
BACKUP_OSS_RETENTION=30
BACKUP_ALLOW_PLAINTEXT=false
PORTABLE_PASSPHRASE=

# ---- Hub Engine 处理开关 ----
AI_PROCESSING_ENABLED=true
AI_SCORING_ENABLED=true
AI_SUMMARY_ENABLED=true
AI_TRANSLATION_ENABLED=true
FETCH_CONCURRENCY=5
FETCH_TIMEOUT_MS=30000
SCRAPLING_ENABLED=true
SCRAPLING_TIMEOUT_MS=20000
KNOWLEDGE_DIR=/app/knowledge

# ============================================================
# C. LLM / ASR / 存储厂商配置
# 先按功能选，再到对应厂商小节填写，不要混着填。
# ============================================================

# ---- 1) 豆包 / 火山方舟 LLM（最小必填组合）----
# 如果你希望 Feed / 日报 / 音频总结优先走豆包，请至少填这 3 个：
# ARK_API_KEY=你的方舟密钥
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DEFAULT_LLM_ENDPOINT_ID=ep-20250922092456-gf47b
# 说明：
# - `DEFAULT_LLM_ENDPOINT_ID` 就是你 curl 里的 `model`
# - `DOUBAO_ENDPOINT_ID` 只是兼容别名，不建议新配置再填它
# - `DEFAULT_LLM_MODEL` / `ARK_MODEL` 对豆包默认选择已不再生效，留空即可
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEFAULT_LLM_ENDPOINT_ID=
DOUBAO_ENDPOINT_ID=
DEFAULT_LLM_MODEL=
ARK_MODEL=

# ---- 2) DashScope（ASR 主路由 / 豆包缺失时的 LLM 回退）----
DASHSCOPE_API_KEY=

# ---- 3) 听悟 Tingwu（长音频 ASR，可选）----
TINGWU_ACCESS_KEY_ID=
TINGWU_ACCESS_KEY_SECRET=
TINGWU_REGION=cn-beijing
TINGWU_APP_KEY=

# ---- 4) 阿里云 OSS（音频存储，推荐）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing

# ---- 5) 其他兼容接口（按需）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_BASE=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
