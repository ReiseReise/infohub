# 音频服务能力变量示例
# 当前 V3 默认也会从 ../audio-insight/backend/.env 与 .env.prod 继承同名变量

# === ASR ===
TINGWU_ACCESS_KEY_ID=
TINGWU_ACCESS_KEY_SECRET=
TINGWU_APP_KEY=
TINGWU_REGION=cn-beijing
DASHSCOPE_API_KEY=

# === LLM ===
DEFAULT_LLM_MODEL=dashscope/qwen-flash
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === 可选豆包 ===
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-pro-32k
